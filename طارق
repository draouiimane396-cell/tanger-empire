<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>الفاتحون - إمبراطورية طنجة</title>
<style>
body{font-family:Arial;background:#0f172a;color:white;margin:0;padding:8px;text-align:center}
.top{background:#1e293b;border-radius:15px;padding:10px;margin-bottom:8px;font-size:14px}
.tabs{display:flex;gap:6px}
.tabs button{flex:1;padding:14px;border:0;border-radius:12px;font-weight:bold;font-size:16px;cursor:pointer}
.active{background:#facc15!important;color:black!important}
.inactive{background:#334155;color:white}
.card{background:#1e293b;border-radius:15px;padding:12px;margin:8px 0;text-align:right}
.build{display:flex;justify-content:space-between;align-items:center;background:#0f172a;padding:10px;border-radius:12px;margin:6px 0}
.build b{font-size:18px}
button.up{background:#16a34a;color:white;border:0;padding:8px 12px;border-radius:10px;font-weight:bold}
button.train{background:#dc2626;color:white;border:0;padding:8px 12px;border-radius:10px;font-weight:bold}
canvas{background:#14532d;border-radius:15px;width:100%;max-width:520px;touch-action:none}
.small{font-size:12px;color:#94a3b8}
</style>
</head>
<body>
<h2>👑 الفاتحون - طنجة</h2>
<div class="top">
💰 <b id="gold">800</b> | 🪵 <b id="wood">500</b> | 🌾 <b id="food">400</b> | 🪨 <b id="stone">200</b><br>
⚔️ جيشك: <b id="army">20</b> قوة: <b id="power">100</b> | 🏆 <b id="msg">مرحبا بك أيها القائد!</b>
</div>

<div class="tabs">
<button id="btnCity" class="active" onclick="show('city')">🏰 مدينتي</button>
<button id="btnMap" class="inactive" onclick="show('map')">🗺️ خريطة العالم</button>
</div>

<!-- المدينة -->
<div id="cityView">
<div class="card"><h3 style="margin:0">🏰 مدينتك - طنجة</h3><p class="small">طور المباني باش يزيدو الموارد و الجيش</p>
<div id="buildings"></div>
</div>
<div class="card"><h3 style="margin:0">⚔️ تجنيد الجيش</h3>
<div class="build"><div><b>🥷 مشاة</b><br><span class="small">قوة 5 - 50 ذهب + 20 أكل</span></div><button class="train" onclick="train('inf')">تجنيد</button></div>
<div class="build"><div><b>🐎 فارس</b><br><span class="small">قوة 15 - 150 ذهب + 50 أكل</span></div><button class="train" onclick="train('horse')">تجنيد</button></div>
<div class="build"><div><b>🏹 رامي</b><br><span class="small">قوة 10 - 100 ذهب + 30 خشب</span></div><button class="train" onclick="train('archer')">تجنيد</button></div>
</div>
</div>

<!-- الخريطة -->
<div id="mapView" style="display:none">
<div class="card"><h3 style="margin:0">🗺️ خريطة العالم</h3><p class="small">كليكي على أي بلاصة باش تهجم ولا تجمع<br>🔴 مدينة عدو | 🟣 لصوص | 🟢 موارد</p></div>
<canvas id="map" width="520" height="360"></canvas>
<div class="card"><button style="width:100%;background:#facc15;padding:12px;border:0;border-radius:10px;font-weight:bold" onclick="collectAll()">🧺 جمع كل الموارد</button></div>
</div>

<script>
let R={gold:800,wood:500,food:400,stone:200};
let army={inf:10,horse:5,archer:5};
let B={
 castle:{name:'🏰 القصر',lvl:1,desc:'كيزيد كل الموارد'},
 barracks:{name:'⚔️ الثكنة',lvl:1,desc:'كيزيد قوة الجيش'},
 farm:{name:'🌾 المزرعة',lvl:1,desc:'كتعطي أكل كل دقيقة'},
 mine:{name:'⛏️ المنجم',lvl:1,desc:'كيعطي ذهب كل دقيقة'},
 wall:{name:'🧱 السور',lvl:1,desc:'كيحمي مدينتك'},
};
let spots=[
 {x:80,y:70,type:'enemy',name:'مدينة سبتة',power:80,reward:{gold:500,wood:200}},
 {x:380,y:80,type:'enemy',name:'مدينة العدو',power:150,reward:{gold:1000,stone:300}},
 {x:200,y:180,type:'thief',name:'عصابة اللصوص',power:40,reward:{gold:200,food:150}},
 {x:420,y:200,type:'thief',name:'لصوص الصحراء',power:60,reward:{gold:300,wood:150}},
 {x:100,y:280,type:'wood',name:'غابة',power:0,reward:{wood:200}},
 {x:300,y:300,type:'gold',name:'منجم ذهب',power:0,reward:{gold:300}},
 {x:260,y:90,type:'food',name:'مزرعة',power:0,reward:{food:250}},
];

function getPower(){ return army.inf*5+army.horse*15+army.archer*10 + B.barracks.lvl*20; }
function getArmyCount(){ return army.inf+army.horse+army.archer; }
function render(){
 document.getElementById('gold').innerText=R.gold;
 document.getElementById('wood').innerText=R.wood;
 document.getElementById('food').innerText=R.food;
 document.getElementById('stone').innerText=R.stone;
 document.getElementById('army').innerText=getArmyCount();
 document.getElementById('power').innerText=getPower();
 let h='';
 for(let k in B){
  let b=B[k]; let cost=200*b.lvl;
  h+=`<div class="build"><div><b>${b.name} - مستوى ${b.lvl}</b><br><span class="small">${b.desc}</span></div><button class="up" onclick="upgrade('${k}')">تطوير<br>${cost} ذهب</button></div>`;
 }
 document.getElementById('buildings').innerHTML=h;
 drawMap();
}
function upgrade(k){
 let cost=200*B[k].lvl;
 if(R.gold<cost) return alert('ما عندكش ذهب كافي!');
 R.gold-=cost; B[k].lvl++; document.getElementById('msg').innerText=`طورتي ${B[k].name} للمستوى ${B[k].lvl}! 🎉`; render();
}
function train(t){
 let costs={inf:{gold:50,food:20},horse:{gold:150,food:50},archer:{gold:100,wood:30}};
 let c=costs[t];
 if(R.gold<c.gold||R.food<(c.food||0)||R.wood<(c.wood||0)) return alert('موارد ناقصة!');
 R.gold-=c.gold; if(c.food) R.food-=c.food; if(c.wood) R.wood-=c.wood;
 army[t]++; document.getElementById('msg').innerText='جندتي جندي جديد! ⚔️'; render();
}
function show(v){
 document.getElementById('cityView').style.display=v=='city'?'block':'none';
 document.getElementById('mapView').style.display=v=='map'?'block':'none';
 document.getElementById('btnCity').className=v=='city'?'active':'inactive';
 document.getElementById('btnMap').className=v=='map'?'active':'inactive';
 if(v=='map') drawMap();
}
function drawMap(){
 let cv=document.getElementById('map'), ctx=cv.getContext('2d');
 ctx.clearRect(0,0,520,360);
 ctx.fillStyle='#14532d'; ctx.fillRect(0,0,520,360);
 // طرق
 ctx.strokeStyle='rgba(255,255,255,0.2)'; ctx.beginPath(); ctx.moveTo(260,180); ctx.lineTo(80,70); ctx.moveTo(260,180); ctx.lineTo(380,80); ctx.stroke();
 // مدينتي فالوسط
 ctx.font='42px Arial'; ctx.fillText('🏰',240,195);
 ctx.fillStyle='white'; ctx.font='bold 13px Arial'; ctx.fillText('طنجة (أنت)',235,215);
 spots.forEach(s=>{
  let em=s.type=='enemy'?'🏯':s.type=='thief'?'🏴‍☠️':s.type=='wood'?'🌲':s.type=='gold'?'⛏️':'🌾';
  ctx.font='34px Arial'; ctx.fillText(em,s.x-17,s.y+10);
  ctx.fillStyle='white'; ctx.font='11px Arial'; ctx.fillText(s.name,s.x-30,s.y+28);
  if(s.power>0) ctx.fillText('قوة: '+s.power,s.x-22,s.y+42);
 });
}
let mapCv=document.getElementById('map');
mapCv.addEventListener('click',e=>{
 let r=mapCv.getBoundingClientRect(); let px=(e.clientX-r.left)*(520/r.width), py=(e.clientY-r.top)*(360/r.height);
 let s=spots.find(s=>Math.hypot(px-s.x,py-s.y)<40); if(!s) return;
 if(s.type=='wood'||s.type=='gold'||s.type=='food'){
  R.gold+=s.reward.gold||0; R.wood+=s.reward.wood||0; R.food+=s.reward.food||0;
  document.getElementById('msg').innerText=`جمعتي من ${s.name}! 🎉`; render(); return;
 }
 // حرب
 if(getPower()>=s.power){
  R.gold+=s.reward.gold||0; R.wood+=s.reward.wood||0; R.food+=s.reward.food||0; R.stone+=s.reward.stone||0;
  // خسرتي شوية جنود
  if(army.inf>0) army.inf=Math.max(0,army.inf-2);
  document.getElementById('msg').innerText=`ربحتي ضد ${s.name}! خديتي الغنيمة 🏆`;
  spots=spots.filter(x=>x!==s);
  // رجع عدو جديد بعد شوية
  setTimeout(()=>{ spots.push({x:100+Math.random()*300,y:60+Math.random()*200,type:'thief',name:'لصوص جداد',power:50,reward:{gold:250,food:100}}); render(); },5000);
 } else {
  document.getElementById('msg').innerText=`خسرتي! قوتك ${getPower()} و العدو ${s.power} - طور جيشك! ❌`;
  if(army.inf>0) army.inf=Math.max(0,army.inf-1);
 }
 render();
});
function collectAll(){ R.gold+=50; R.wood+=50; R.food+=50; document.getElementById('msg').innerText='جمعتي موارد!'; render(); }
// موارد كل 10 ثواني من المباني
setInterval(()=>{
 R.gold+=B.castle.lvl*10+B.mine.lvl*20;
 R.food+=B.farm.lvl*20+B.castle.lvl*5;
 R.wood+=B.castle.lvl*10;
 R.stone+=B.castle.lvl*5;
 render();
},10000);
render();
</script>
</body>
</html>